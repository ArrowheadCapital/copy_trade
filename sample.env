# StratX option instrument master CSV.
OPTION_INSTRUMENT_CSV=C:/path/to/options_instruments.csv

# Maximum permitted age of a source trade row, in seconds.
COPY_ALLOWED_DELAY_SECONDS=120

# Slack webhook used only when runtime GreekSoft token-file recovery is unavailable.
GREEK_AUTH_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
